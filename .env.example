# ===== Firebase (get from Firebase Console > Project Settings) =====
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abc123def456"

# ===== Site =====
VITE_SITE_URL="http://localhost:8080"
VITE_SUBSCRIPTION_ENABLED="true"
VITE_PROVIDER_EMAIL_PASSWORD="true"
VITE_EDGE_FUNCTIONS_BASE_URL="/v1/api"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# ===== AI Providers (get keys from respective services) =====
VITE_GEMINI_API_KEYS="your_gemini_api_key_1,your_gemini_api_key_2"
VITE_GITHUB_TOKEN="your_github_token"
VITE_GROQ_API_KEYS="your_groq_api_key"
VITE_NVIDIA_API_KEYS="your_nvidia_api_key"
VITE_OPENROUTER_API_KEYS="your_openrouter_api_key"
VITE_UNSPLASH_ACCESS_KEY="your_unsplash_access_key"
